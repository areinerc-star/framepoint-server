# ── Copy this file to .env and fill in your values ──

# Your Gmail address (used to send all emails)
GMAIL_USER=your.gmail@gmail.com

# Gmail App Password (NOT your regular password)
# How to get it: Google Account → Security → 2-Step Verification → App Passwords
# Create one for "Mail" → copy the 16-character password here
GMAIL_PASS=xxxx xxxx xxxx xxxx

# The business email that receives booking requests (can be same as GMAIL_USER)
BUSINESS_EMAIL=framepoint.photography@gmail.com

# Your Railway public URL (set this after deploying to Railway)
# Example: https://framepoint-booking.up.railway.app
BASE_URL=https://your-app.up.railway.app
