# ── Copy this into Vercel → Project → Settings → Environment Variables ──
# (Don't commit a real .env file — this is just a reference.)

# The business email that receives new booking notifications
BUSINESS_EMAIL=framepoint.photography@gmail.com

# Your live Vercel URL, used to build the approve/deny links in emails.
# Example: https://framepoint-server.vercel.app
BASE_URL=https://your-project.vercel.app

# Password required to use the admin dashboard / admin API routes.
# Change this to something only you know.
ADMIN_PASS=framepoint2026

# Optional — only needed if you want to override the Make.com webhook URL
# baked into lib/make.js
MAKE_WEBHOOK_URL=https://hook.us2.make.com/66idvdk88i8q4ss42hzacc754icb77wn

# ── These are added AUTOMATICALLY by Vercel ──
